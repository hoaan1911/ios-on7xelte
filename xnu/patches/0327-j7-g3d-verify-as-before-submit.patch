+/*
+ * 0326 showed the translation fault itself is real - the GPU walks a leaf this driver believes it
+ * wrote, the fault repair fills that leaf in, and by then the job slot has faulted, so the submit
+ * times out and Mesa throws the batch away.  Repairing after the fault cannot win that race.  The
+ * tables are therefore re-validated against the BO descriptors *before* the walker runs: every
+ * submit checks a bounded slice of the address space with a rotating per-BO cursor, and every map
+ * re-walks the BO it just created.  A hole is filled before the GPU reaches it, and the counters
+ * say how many holes the last submit would have faulted on.
+ */
+#define J7M_VERIFY_BUDGET   4096        /* pages checked per submit, spread over every BO */
+#define J7M_VERIFY_LOG      24          /* log lines for the first holes found, then every 120 submits */
+
+static bool
+j7m_verify_bo(struct J7MaliBo *bo, unsigned cursor, unsigned budget, unsigned *checked,
+    unsigned *fixed, unsigned *unknown, unsigned *next)
+{
+    bool changed = false;
+    unsigned n = 0;
+
+    *next = 0;
+    if (!bo->used || bo->size < J7M_PAGE) {
+        return false;
+    }
+    const uint64_t pages = bo->size / J7M_PAGE;
+    if (cursor >= pages) {
+        cursor = 0;
+    }
+    for (; n < budget && n < pages; n++) {
+        const uint64_t at = bo->va + (uint64_t)((cursor + n) % pages) * J7M_PAGE;
+        uint64_t pa = 0, have = 0;
+        if (!j7m_bo_page(bo, at, &pa)) {
+            (*unknown)++;
+            continue;
+        }
+        (*checked)++;
+        if (j7m_lookup(at, &have) && have == pa) {
+            continue;
+        }
+        if (j7m_map_page_at(at, pa, true)) {
+            (*fixed)++;
+            changed = true;
+        }
+    }
+    *next = (unsigned)((cursor + n) % pages);
+    return changed;
+}
+
+/* Lock held.  Check one moving slice of AS0 right before a chain is handed to the job manager. */
+static void
+j7m_verify_as(unsigned budget)
+{
+    static unsigned startIdx, calls, shown;
+    unsigned checked = 0, fixed = 0, unknown = 0;
+    bool changed = false;
+
+    if (!gJ7M.poolVA || !gJ7M.root) {
+        return;
+    }
+    calls++;
+    for (unsigned i = 0; i < J7M_MAX_BOS && checked + unknown < budget; i++) {
+        struct J7MaliBo *bo = &gJ7M.bos[(startIdx + i) % J7M_MAX_BOS];
+        unsigned boFixed = 0, next = 0;
+
+        if (!bo->used) {
+            continue;
+        }
+        if (j7m_verify_bo(bo, bo->verifyCursor, budget, &checked, &boFixed, &unknown, &next)) {
+            j7m_pool_sync();
+            (void)j7m_mmu_flush(bo->va, bo->size);
+            changed = true;
+        }
+        bo->verifyCursor = next;
+        fixed += boFixed;
+    }
+    startIdx = (startIdx + 1) % J7M_MAX_BOS;
+    if ((changed || unknown || (calls % 120) == 0) && (shown < J7M_VERIFY_LOG || (calls % 120) == 0)) {
+        shown++;
+        IOLog("J7 G3D: submit verify: checked=%u filled=%u unknown=%u tables=%u/%u\n",
+            checked, fixed, unknown, gJ7M.poolUsed, gJ7M.poolTables);
+    }
+}
+
+/* Lock held.  Walk a BO that was just mapped: a leaf that does not read back is written again. */
+static void
+j7m_map_verify(struct J7MaliBo *bo)
+{
+    static unsigned shown;
+    unsigned checked = 0, fixed = 0, unknown = 0, next = 0;
+    const unsigned pages = (unsigned)(bo->size / J7M_PAGE);
+
+    if (j7m_verify_bo(bo, 0, pages > 4096 ? 4096 : pages, &checked, &fixed, &unknown, &next)) {
+        j7m_pool_sync();
+        (void)j7m_mmu_flush(bo->va, bo->size);
+    }
+    bo->verifyCursor = next;
+    if (shown++ < J7M_VERIFY_LOG) {
+        IOLog("J7 G3D: map verify: bo=%u gva=%llx pages=%u missing=%u unknown=%u\n",
+            (unsigned)(bo - gJ7M.bos) + 1, (unsigned long long)bo->va, pages, fixed, unknown);
+    }
+}
