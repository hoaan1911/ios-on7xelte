 /*
+ * The client's surface arrives cache-inhibited, where every 32-bit load is its own bus
+ * transaction: one 3000-byte row cost 47 us, which was most of the frame.  Load two pixels
+ * per transaction instead, four loads at a time so the controller can pipeline them, and
+ * fall back to memcpy only for a row that is not 8-byte aligned.
+ */
+static void
+sweet_fb_row_copy(uint32_t *dst, const uint32_t *src, int32_t n)
+{
+	if ((((uintptr_t)src | (uintptr_t)dst) & 7u) != 0) {
+		memcpy(dst, src, (size_t)n * 4);
+		return;
+	}
+	const uint64_t *s = (const uint64_t *)src;
+	uint64_t *d = (uint64_t *)dst;
+	const int32_t pairs = n >> 1;
+	int32_t i = 0;
+	for (; i + 3 < pairs; i += 4) {
+		const uint64_t a = s[i], b = s[i + 1], c = s[i + 2], e = s[i + 3];
+		d[i] = a;
+		d[i + 1] = b;
+		d[i + 2] = c;
+		d[i + 3] = e;
+	}
+	for (; i < pairs; i++) {
+		d[i] = s[i];
+	}
+	if (n & 1) {
+		dst[n - 1] = src[n - 1];
+	}
+}
