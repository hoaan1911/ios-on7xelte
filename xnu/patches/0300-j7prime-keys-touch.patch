index 7ba309b..9bb0873 100644
--- a/bsd/dev/a5xelte_touch.c
+++ b/bsd/dev/a5xelte_touch.c
@@ -615,6 +615,615 @@ a5touch_start_early(vm_offset_t nfc, vm_offset_t alive)
