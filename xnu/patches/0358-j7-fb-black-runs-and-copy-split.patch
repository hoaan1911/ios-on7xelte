 		/* Two pixels per store. The present copy measured 34 ms for 8.29 MB, which is about
 		 * 15 cycles per four-byte store: the panel map costs one bus transaction per store and
@@ -799,10 +814,15 @@
 				out[pw - 1] = row[pw - 1];
