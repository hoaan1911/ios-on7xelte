-			c[0x204 / 4] = umux0;
-			mif[cpu[i].swdiv / 4] = swdiv0;
-			mif[cpu[i].gate / 4] = gate0;
+			c[0x208 / 4] = mux0;
 			__asm__ volatile ("dsb sy" ::: "memory");
 			OSSafeReleaseNULL(map);
 			OSSafeReleaseNULL(desc);
 			continue;
 		}
-		/* PLL: its lock time, then M/P/S with the bits the vendor code keeps set and clear. */
+		/* PLL: lock time P * 150, then M/P/S with the bits the vendor code keeps. */
 		c[0x000 / 4] = 4u * 150u;
 		c[0x100 / 4] = (con0 & ~0x03ff3f07u & ~(1u << 26)) |
 		    (1u << 31) | (1u << 5) | (m << 16) | (4u << 8);
 		__asm__ volatile ("dsb sy" ::: "memory");
-		for (n = 0; n < 100; n++) {
+		for (n = 0; n < 250; n++) {
 			if (c[0x100 / 4] & (1u << 29)) {
