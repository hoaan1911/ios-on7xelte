From: j7 fb
Subject: j7 fb: paint the panel blue before the first frame

An empty compositor frame leaves the panel black, which cannot be told apart from a dead display.
Fill the scanout with blue once in AppleCLCD::start(); the first frame CoreAnimation presents
replaces it.  sweetfb_bg=0 disables the fill.

diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 32ce4b2..a6d23f6 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -267,6 +267,24 @@ AppleCLCD::start(IOService *provider)
 		OSSafeReleaseNULL(fWorkLoop);
 		return false;
 	}
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+	/* Wallpaper test: an empty compositor frame leaves the panel black, which cannot be told
+	 * apart from a dead display.  Fill the scanout blue once here; the first real frame that
+	 * CoreAnimation presents replaces it.  sweetfb_bg=0 disables. */
+	int bg = 1;
+	PE_parse_boot_argn("sweetfb_bg", &bg, sizeof(bg));
+	if (bg) {
+		uint32_t *base = reinterpret_cast<uint32_t *>(fPixels);
+		const uint32_t stride = fRowBytes / 4;
+		for (uint32_t y = 0; y < fHeight; y++) {
+			uint32_t *row = base + (uintptr_t)y * stride;
+			for (uint32_t x = 0; x < fWidth; x++) {
+				row[x] = 0xff1e3a8a;    /* BGRA blue: B 8a, G 3a, R 1e, A ff */
+			}
+		}
+		IOLog("SWEET FB: panel painted blue %ux%u (sweetfb_bg=0 to disable)\n", fWidth, fHeight);
+	}
+#endif
 	fVsync = IOTimerEventSource::timerEventSource(this, &AppleCLCD::vsyncFired);
 	if (fVsync == NULL || fWorkLoop->addEventSource(fVsync) != kIOReturnSuccess) {
 		IOLog("SWEET FB: no vsync timer\n");
