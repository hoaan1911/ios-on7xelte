From: j7 fb
Subject: j7: carry the wallpaper inside the kernel

There is no host-visible storage on the phone yet, so a file cannot be pushed to the

data volume - the user is right about that. The boot image is the only thing that

reaches the phone, so the picture travels in it: tools/j7wall.py turns the photo

into half-size RGB565 (375x667, 500,250 bytes) and present() expands it to the

logical display the first time it runs.

A raw BGRA file at /var/mobile/j7wall.raw still wins if one exists, so a real

storage driver later needs no new code. The expansion is nearest neighbour and

runs once, at first present, not per frame.

Co-Authored-By: dipa-studio <183933817+dipa-studio@users.noreply.github.com>

diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -80,6 +80,9 @@
 #include <sys/kauth.h>
 #include <sys/vfs_context.h>
 #endif
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+#include "j7wall_data.h"    /* tools/j7wall.py output: the picture below, RGB565 */
+#endif
 
 #if defined(ARM64_BOARD_CONFIG_HEROLTE)
 static void sweet_fb_copy_init(void);
@@ -893,6 +896,34 @@
 static int sweet_fb_wall_tried;
 
 #if defined(ARM64_BOARD_CONFIG_A5XELTE)
+/*
+ * Expand the compiled-in picture to the logical display size. Nothing is visible to a
+ * computer yet, so the only thing that can reach the phone is the boot image: the
+ * wallpaper travels inside the kernel instead of in a file the user would have to push.
+ * The data is half size RGB565; nearest neighbour both ways, once, at first present.
+ */
+static void
+sweet_fb_wall_embedded(uint32_t *dst, int32_t w, int32_t h)
+{
+	for (int32_t y = 0; y < h; y++) {
+		int64_t sy = (int64_t)y * J7WALL_HEIGHT / h;
+		const unsigned short *srow = j7wall_data + sy * J7WALL_WIDTH;
+		uint32_t *drow = dst + (int64_t)y * w;
+		int32_t sx = 0;
+		for (int32_t x = 0; x < w; x++) {
+			while (sx + 1 < J7WALL_WIDTH && (int64_t)(sx + 1) * w <= (int64_t)x * J7WALL_WIDTH) {
+				sx++;
+			}
+			uint32_t v = srow[sx];
+			uint32_t r = (v >> 11) & 0x1fu;
+			uint32_t g = (v >> 5) & 0x3fu;
+			uint32_t b = v & 0x1fu;
+			drow[x] = 0xff000000u | (((r << 3) | (r >> 2)) << 16) |
+			    (((g << 2) | (g >> 4)) << 8) | ((b << 3) | (b >> 2));
+		}
+	}
+}
+
 static void
 sweet_fb_wall_load(int32_t w, int32_t h)
 {
@@ -912,18 +943,20 @@
 		return;
 	}
 	if (vnode_open(path, FREAD, 0, 0, &vp, ctx) != 0 || vp == NULL) {
-		IOLog("A5XELTE FB: no wallpaper at %s\n", path);
-		IOFreeData(sweet_fb_wall, (vm_size_t)size);
-		sweet_fb_wall = NULL;
+		IOLog("A5XELTE FB: no wallpaper at %s, using the built-in picture\n", path);
+		sweet_fb_wall_embedded(sweet_fb_wall, w, h);
+		sweet_fb_wall_w = w;
+		sweet_fb_wall_h = h;
 		return;
 	}
 	int error = vn_rdwr(UIO_READ, vp, (caddr_t)sweet_fb_wall, size, 0, UIO_SYSSPACE,
 	    IO_NODELOCKED | IO_NOCACHE, kauth_cred_get(), NULL, NULL);
 	vnode_close(vp, FREAD, ctx);
 	if (error != 0) {
-		IOLog("A5XELTE FB: wallpaper read %d\n", error);
-		IOFreeData(sweet_fb_wall, (vm_size_t)size);
-		sweet_fb_wall = NULL;
+		IOLog("A5XELTE FB: wallpaper read %d, using the built-in picture\n", error);
+		sweet_fb_wall_embedded(sweet_fb_wall, w, h);
+		sweet_fb_wall_w = w;
+		sweet_fb_wall_h = h;
 		return;
 	}
 	sweet_fb_wall_w = w;
