+/* Wait for every chain that is in flight.  The client submits one chain per ioctl and waits for it
+ * straight away, but a second render thread can start another slot meanwhile: the wait has to cover
+ * each slot that has a chain, or the older one keeps its slot marked busy and the next submit to it
+ * is refused, which is a failed Mesa batch and a compositor that never draws again. */
+static int
+j7m_wait(unsigned timeout_us)
+{
+    int rc = 0;
+
+    for (unsigned slot = 0; slot < 3; slot++) {
+        if (!(gJ7M.inflightMask & (1u << slot))) {
+            continue;
+        }
+        const int r = j7m_wait_slot(slot, timeout_us);
+        if (r != 0 && rc == 0) {
+            rc = r;
+        }
+    }
+    return rc;
+}
