From: j7 gpu
Subject: j7 g3d: dump the job slot when a client chain never completes

Every Mesa chain still ends with status=-1 while the kernel's own selftest on the same slot returns
status=0 and a deliberately faulted slot reports js=00000008.  From the client that is
indistinguishable from "START never latched", "job faulted" and "MMU fault": the boot log has
exactly one `fault at` line, the selftest's own, so no client chain ever reaches the MMU fault path.

This patch makes the driver answer it: the first four failed submits log JS_STATUS at +0x20 and
+0x24, JS_CONFIG_NEXT, JS_COMMAND_NEXT, JOB_IRQ_RAWSTAT and the two words after it,
MMU_IRQ_RAWSTAT, AS0 fault status and TRANSTAB, and GPU_FAULT_STATUS.  It also lowers the dead-slot
check from 2 ms to 150 us so it actually runs inside the 600 us client timeout (0335 lowered the cap
and silently disabled that check), and clears a latched JS_COMMAND_NEXT after a failure so a start
the job manager never took cannot wedge the slot.

diff --git a/iokit/Kernel/arm/A5XELTEGPU.cpp b/iokit/Kernel/arm/A5XELTEGPU.cpp
index b2e9637..103a58b 100644
--- a/iokit/Kernel/arm/A5XELTEGPU.cpp
+++ b/iokit/Kernel/arm/A5XELTEGPU.cpp
@@ -1177,6 +1177,7 @@ j7m_wait(unsigned timeout_us)
         return 0;
     }
     const uint32_t slot = gJ7M.inflightSlot;
+    const uint32_t jsreg = J7M_JS(slot);
     unsigned repairs = 0;
     for (;;) {
         uint32_t jobIRQ = 0, mmuIRQ = 0;
@@ -1189,7 +1190,7 @@ j7m_wait(unsigned timeout_us)
             /* A slot that is no longer active will never raise that interrupt: waiting out the full
              * client timeout for it is the "nothing happens for five seconds" stall, so give it 2 ms
              * of grace and then report the slot as dead. */
-            if (us >= 1000 && (us % 500) == 0) {
+            if (us >= 150 && (us % 50) == 0) {
                 /* JS_STATUS is the word at +0x20 (JOB_HEAD_LO/HI are +0x00/+0x04, the *_NEXT
                  * copies +0x40 and up); +0x24 used to be read here and logged as "js", which is
                  * only the running head's high half.  Bit 0 is ACTIVE. */
@@ -1231,6 +1232,11 @@ j7m_wait(unsigned timeout_us)
                 }
             }
         }
+        if (rc != 0) {
+            /* A start command the job manager never took stays latched in JS_COMMAND_NEXT and every
+             * later submit to that slot is refused; drop it so the slot keeps accepting work. */
+            a5g3d_write32(gJ7M.gpu, jsreg + 0x60, 0);
+        }
         a5g3d_write32(gJ7M.gpu, J7M_JOB_IRQ_CLEAR, jobIRQ);
         a5g3d_write32(gJ7M.gpu, J7M_MMU_IRQ_CLEAR, mmuIRQ);
         gJ7M.inflight = false;
@@ -1776,9 +1782,30 @@ J7MaliUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *a
              * seconds only ever waited out a job slot that was already dead. */
             const unsigned timeout = static_cast<unsigned>(args->scalarInput[0] > 600 ? 600 : args->scalarInput[0]);
             int rc = j7m_wait(timeout);
+            const uint32_t jsReg = a5g3d_read32(gJ7M.gpu, J7M_JS(slot) + 0x20);
             const uint32_t js = wasInflight ? a5g3d_read32(gJ7M.gpu, J7M_JS(slot) + 0x24) : 0;
             j7m_cache(kIOMemoryIncoherentIOFlush);
             if (rc != 0) {
+                /* Why did a real client chain never complete?  Dump the job slot and the fault block
+                 * once per boot (four times) instead of guessing: a chain whose START never latched
+                 * (JS_COMMAND_NEXT still set), one that faulted (JS_STATUS exception nibble), and an
+                 * MMU fault all look the same from the client. */
+                static unsigned dumps;
+                if (dumps++ < 4) {
+                    IOLog("J7 G3D: dump %u slot=%u rc=%d js_status(+20)=%08x js_status(+24)=%08x "
+                        "js_config(+58)=%08x js_cmd(+60)=%08x\n", dumps, slot, rc, jsReg, js,
+                        a5g3d_read32(gJ7M.gpu, J7M_JS(slot) + 0x58),
+                        a5g3d_read32(gJ7M.gpu, J7M_JS(slot) + 0x60));
+                    IOLog("J7 G3D: dump %u job_irq raw=%08x stat=%08x mask=%08x mmu_irq raw=%08x "
+                        "as_fault=%08x as_transtab=%08x gpu_fault=%08x\n", dumps,
+                        a5g3d_read32(gJ7M.gpu, J7M_JOB_IRQ_RAWSTAT),
+                        a5g3d_read32(gJ7M.gpu, J7M_JOB_IRQ_RAWSTAT + 8),
+                        a5g3d_read32(gJ7M.gpu, J7M_JOB_IRQ_RAWSTAT + 12),
+                        a5g3d_read32(gJ7M.gpu, J7M_MMU_IRQ_RAWSTAT),
+                        a5g3d_read32(gJ7M.gpu, J7M_AS0 + 0x1c),
+                        a5g3d_read32(gJ7M.gpu, J7M_AS0 + 0x00),
+                        a5g3d_read32(gJ7M.gpu, 0xf3c));
+                }
                 /* A soft reset tears down the MMU, the cores and every mapping; doing that for
                  * every failed chain was the bulk of the frame time.  Only reset once a few
                  * have failed in a row, or at once when the MMU itself faulted. */
