From: j7
Subject: j7: use the touch driver's I2C sequence and find the fuel gauge bus

IICSTAT on the fuel-gauge driver read back exactly the 0xf0 it had just written, which

means no transfer ever started: the bytes went in after the mode byte and the prescaler

was 0xef. a5xelte_touch.c proves the sequence on this SoC (control 0xe3, filter 7,

address, mode, mode|ENABLE) on two different buses, so use that, and probe each S3C I2C

controller for the gauge instead of trusting one address. Read-only registers only.

Co-Authored-By: dipa-studio <183933817+dipa-studio@users.noreply.github.com>

diff --git a/bsd/dev/a5xelte_battery.c b/bsd/dev/a5xelte_battery.c
--- a/bsd/dev/a5xelte_battery.c
+++ b/bsd/dev/a5xelte_battery.c
@@ -107,11 +107,11 @@
 		}
 		delay(1);
 	}
-	/* Bits 3:0 are the clock prescaler. 0xe1 (prescaler 1) ACKed the address and then never
-	 * finished, and the read-back of 0xe3 also came back as 0xe1, so try the slowest step first:
-	 * a gauge that answers but cannot complete a byte is usually clocking faster than it can
-	 * follow, and 16*(15+1) divides the bus clock far harder than 16*(3+1). */
-	fg_wr(FG_CON, 0xefu);
+	/* Exactly the sequence a5xelte_touch.c proves on this SoC: control and filter, the
+	 * address into IICDS, the mode byte into IICSTAT, then the same byte with ENABLE. The
+	 * prescaler is 0xe3 (the touch driver's value); 0xef with the bytes in the other order
+	 * left IICSTAT reading back the 0xf0 just written, i.e. no transfer ever started. */
+	fg_wr(FG_CON, 0xe3u);
 	fg_wr(FG_FILTER, 7u);
 	fg_wr(FG_DS, FG_ADDR | (receive ? 1u : 0u));
 	fg_wr(FG_STAT, receive ? FG_MODE_RX : FG_MODE_TX);
@@ -174,17 +174,31 @@
 	if (!enabled) {
 		return -1;
 	}
-	fg_i2c = ml_io_map(FG_I2C_PA, 0x1000);
-	if (!fg_i2c) {
-		return -1;
-	}
-	uint16_t soc = 0xffff;
-	if (!fg_word(FG_REPSOC, &soc)) {
-		printf("A5XELTE FG: nothing at 0x3b on the i2c@13830000 bus\n");
-		return -1;
+	/* The gauge is somewhere on the S3C-style I2C controllers, and Samsung's own tree does
+	 * not agree between the 7870 boards about which one: the touch driver here already proves
+	 * two of them answer (0x13840000 and 0x13850000). Ask every bus for the same read-only
+	 * register and keep the one that ACKs, instead of trusting one address. */
+	static const uint32_t buses[] = {
+		0x13830000u, 0x13860000u, 0x13870000u, 0x13880000u, 0x13890000u,
+	};
+	for (unsigned i = 0; i < sizeof(buses) / sizeof(buses[0]); i++) {
+		uint16_t soc = 0xffff;
+		fg_i2c = ml_io_map(buses[i], 0x1000);
+		if (!fg_i2c) {
+			continue;
+		}
+		fg_errors = 1000000u;   /* the scan logs itself, one line per bus */
+		if (fg_word(FG_REPSOC, &soc)) {
+			fg_errors = 0;
+			printf("A5XELTE FG: S2MU004 on 0x%08x, RSOC=%#x (1/16384 of full)\n",
+			    buses[i], soc);
+			return 0;
+		}
+		printf("A5XELTE FG: nothing at 0x3b on 0x%08x, stat=%#x con=%#x\n",
+		    buses[i], fg_rd(FG_STAT), fg_rd(FG_CON));
 	}
-	printf("A5XELTE FG: S2MU004 answers, RSOC=%#x (1/16384 of full)\n", soc);
-	return 0;
+	printf("A5XELTE FG: no gauge answered on any I2C bus\n");
+	return -1;
 }
 
