-		bool switched = false, locked = false;
+		bool onOsc = false, locked = false;
 
 		IOLog("A5XELTE CPU: %s PLL_CON0=%08x M=%u P=%u S=%u -> %llu kHz, div %u/%u -> %llu kHz, mux %u, asked for %u\n",
 		    cpu[i].name, con0, cm, cp, cs, pll, d1, d2, arm, (mux0 >> 12) & 3u, khz);
@@ -334,73 +324,60 @@
 			OSSafeReleaseNULL(desc);
 			continue;
 		}
-		/* Switch source: gate on, the MIF switch on the source mux, the 800 MHz step. */
-		mif[cpu[i].gate / 4] = gate0 | 1u;
-		c[0x204 / 4] = (c[0x204 / 4] | (1u << 12)) & ~(1u << 27);
-		__asm__ volatile ("dsb sy" ::: "memory");
-		IOSleep(1);
-		mif[cpu[i].swdiv / 4] = swdiv0 & ~3u;
-		__asm__ volatile ("dsb sy" ::: "memory");
-		IOSleep(1);
-		/* ARMCLK onto the switch: bit 12 set, status reads 2. */
+		/* ARMCLK to the switch input (+0x208 bit 12).  +0x204 is left alone, so that
+		 * input is OSCCLK, the 26 MHz oscillator: the only clock that is always
+		 * running, and the one the 0380 boot came up on instead of dying. */
 		c[0x208 / 4] = (mux0 & ~(1u << 12)) | (1u << 12);
 		__asm__ volatile ("dsb sy" ::: "memory");
-		for (n = 0; n < 100; n++) {
+		for (n = 0; n < 250; n++) {
 			if (((c[0x608 / 4] >> 12) & 3u) == 2u) {
-				switched = true;
+				onOsc = true;
 				break;
 			}
-			IOSleep(1);
+			IODelay(20);
 		}
-		if (!switched) {
-			IOLog("A5XELTE CPU: %s did not move to the switch (status %08x), left alone\n",
+		if (!onOsc) {
+			IOLog("A5XELTE CPU: %s did not take the oscillator (status %08x), left alone\n",
