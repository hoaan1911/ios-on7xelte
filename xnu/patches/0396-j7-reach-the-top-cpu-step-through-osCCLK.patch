-		const uint32_t umux0 = c[0x204 / 4], mux0 = c[0x208 / 4];
-		const uint32_t gate0 = mif[cpu[i].gate / 4], swdiv0 = mif[cpu[i].swdiv / 4];
+		const uint32_t mux0 = c[0x208 / 4];
