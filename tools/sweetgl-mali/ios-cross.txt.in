[binaries]
c = ['@CLANG@', '-arch', 'arm64', '-isysroot', '@SDK@', '-miphoneos-version-min=16.0']
cpp = ['@CLANGXX@', '-arch', 'arm64', '-isysroot', '@SDK@', '-miphoneos-version-min=16.0']
objc = ['@CLANG@', '-arch', 'arm64', '-isysroot', '@SDK@', '-miphoneos-version-min=16.0']
ar = '@AR@'
strip = '@STRIP@'
pkg-config = 'false'

[built-in options]
# arm64 iOS is little-endian: say so, because Mesa's flex-generated lexers include standard headers
# before the source they came from, and on the iOS 18.5 SDK that leaves u_endian.h without the
# __BYTE_ORDER__ it derives the endianness from ("UTIL_ARCH_... were unset").
c_args = ['-I@INC@', '-DUTIL_ARCH_LITTLE_ENDIAN=1', '-DUTIL_ARCH_BIG_ENDIAN=0']
cpp_args = ['-I@INC@', '-DUTIL_ARCH_LITTLE_ENDIAN=1', '-DUTIL_ARCH_BIG_ENDIAN=0']

[host_machine]
system = 'darwin'
subsystem = 'ios'
cpu_family = 'aarch64'
cpu = 'arm64'
endian = 'little'
