 			    cpu[i].name, khz, c[0x100 / 4]);
 			c[0x100 / 4] = con0;
 			__asm__ volatile ("dsb sy" ::: "memory");
-			for (n = 0; n < 100; n++) {
+			for (n = 0; n < 250; n++) {
 				if (c[0x100 / 4] & (1u << 29)) {
