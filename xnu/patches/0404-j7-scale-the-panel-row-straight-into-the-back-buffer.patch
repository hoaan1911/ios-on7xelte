+	/* fFlip paints a cacheable back buffer, so the scaled row can be written where it goes.
+	 * Staging it in row[] and memcpy()ing it there added a 4,320-byte pass per panel row -
+	 * 5.7 MB of cached reads and writes per frame - and changed nothing else. */
+	const bool direct = fFlip != 0 && !banded;
+#else
+	const bool direct = false;
+#endif
 	int32_t bandRows = 0, bandFirst = 0;
 	for (int32_t py = py0; py < py1; py++) {
 		int32_t r = py * (int32_t)fLogicalH / (int32_t)fHeight - dy;
@@ -1572,12 +1580,20 @@
 					}
