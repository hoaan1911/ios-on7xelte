 			    sweet_fb_swap_count, sweet_fb_swap_waits,
 			    sweet_fb_swap_waits ? sweet_fb_swap_wait_us / sweet_fb_swap_waits : 0);
@@ -742,15 +748,17 @@
 		column[x] = (uint16_t)(c < 0 ? 0 : (c >= w ? w - 1 : c));
 	}
 	int32_t previous = -1;
+	uint64_t buildStart = 0, storeStart = 0;
 	for (int32_t py = py0; py < py1; py++) {
