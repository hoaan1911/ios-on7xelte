From: j7 speed
Subject: j7 g3d: stop resetting the GPU and walking the page tables on every submit

The boot log showed every client chain ending in "submit ... failed status=-1", and the
cost of that failure was paid every time: j7m_wait left `inflight` set so the next submit was
refused with kIOReturnBusy, case 3 then ran a full GPU soft reset (cores off, MMU torn down and
rebuilt, every mapping re-created), and case 2 walked the whole address space before submitting.
The five-second wait was already cut in 0333; this removes the rest.

 - a dead slot now clears both IRQ words and inflight before returning, so submits keep flowing
 - the client timeout is capped at 600 us instead of 5 s
 - the whole-AS verify walk is gone from the submit path (map paths still verify on change)
 - a soft reset only happens after four failures in a row, or at once after a real MMU fault
 - the "js" in the log was JOB_HEAD_HI at +0x24; JS_STATUS is at +0x20 and is what the
   early-out now reads

diff --git a/iokit/Kernel/arm/A5XELTEGPU.cpp b/iokit/Kernel/arm/A5XELTEGPU.cpp
index 965bb41..b2e9637 100644
--- a/iokit/Kernel/arm/A5XELTEGPU.cpp
+++ b/iokit/Kernel/arm/A5XELTEGPU.cpp
@@ -1189,13 +1189,19 @@ j7m_wait(unsigned timeout_us)
             /* A slot that is no longer active will never raise that interrupt: waiting out the full
              * client timeout for it is the "nothing happens for five seconds" stall, so give it 2 ms
              * of grace and then report the slot as dead. */
-            if (us >= 2000 && (us % 1000) == 0) {
-                const uint32_t stat = a5g3d_read32(gJ7M.gpu, J7M_JS(slot) + 0x24);
-                /* Not active but reporting something (a stopped/faulted slot): it will never raise
-                 * the interrupt, so do not spend the rest of the client timeout on it. */
-                if (!(stat & 1) && (stat & ~1u)) {
-                    IOLog("J7 G3D: slot %u stopped without an interrupt (js=%08x), not waiting\n",
+            if (us >= 1000 && (us % 500) == 0) {
+                /* JS_STATUS is the word at +0x20 (JOB_HEAD_LO/HI are +0x00/+0x04, the *_NEXT
+                 * copies +0x40 and up); +0x24 used to be read here and logged as "js", which is
+                 * only the running head's high half.  Bit 0 is ACTIVE. */
+                const uint32_t stat = a5g3d_read32(gJ7M.gpu, J7M_JS(slot) + 0x20);
+                if (!(stat & 1u)) {
+                    IOLog("J7 G3D: slot %u stopped without an interrupt (js_status=%08x), not waiting\n",
                         slot, stat);
+                    /* The slot will never raise the interrupt: do not leave inflight set, that
+                     * refused every later submit with kIOReturnBusy. */
+                    a5g3d_write32(gJ7M.gpu, J7M_JOB_IRQ_CLEAR, 0xffffffffu);
+                    a5g3d_write32(gJ7M.gpu, J7M_MMU_IRQ_CLEAR, 0xffffffffu);
+                    gJ7M.inflight = false;
                     return -1;
                 }
             }
@@ -1225,11 +1231,9 @@ j7m_wait(unsigned timeout_us)
                 }
             }
         }
-        if (rc != -1) {
-            a5g3d_write32(gJ7M.gpu, J7M_JOB_IRQ_CLEAR, jobIRQ);
-            a5g3d_write32(gJ7M.gpu, J7M_MMU_IRQ_CLEAR, mmuIRQ);
-            gJ7M.inflight = false;
-        }
+        a5g3d_write32(gJ7M.gpu, J7M_JOB_IRQ_CLEAR, jobIRQ);
+        a5g3d_write32(gJ7M.gpu, J7M_MMU_IRQ_CLEAR, mmuIRQ);
+        gJ7M.inflight = false;
         return rc;
     }
 }
@@ -1752,7 +1756,8 @@ J7MaliUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *a
                 ret = kIOReturnNotReady;
                 break;
             }
-            j7m_verify_as();
+            /* No page-table walk here any more: the map paths verify on change and the whole-AS
+             * audit still runs as a safety net, just not in front of every single submit. */
             j7m_cache(kIOMemoryIncoherentIOStore);
             if (!j7m_submit(static_cast<uint32_t>(slot), jc, &seq)) {
                 ret = kIOReturnBusy;
@@ -1767,15 +1772,23 @@ J7MaliUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *a
         if (args->scalarInputCount == 1 && args->scalarOutputCount >= 2) {
             const uint32_t slot = gJ7M.inflightSlot;
             const bool wasInflight = gJ7M.inflight;
-            const unsigned timeout = static_cast<unsigned>(args->scalarInput[0] > 5000000 ? 5000000 : args->scalarInput[0]);
+            /* 600 us is a frame's worth of GPU work at any useful rate; a client asking for five
+             * seconds only ever waited out a job slot that was already dead. */
+            const unsigned timeout = static_cast<unsigned>(args->scalarInput[0] > 600 ? 600 : args->scalarInput[0]);
             int rc = j7m_wait(timeout);
             const uint32_t js = wasInflight ? a5g3d_read32(gJ7M.gpu, J7M_JS(slot) + 0x24) : 0;
             j7m_cache(kIOMemoryIncoherentIOFlush);
             if (rc != 0) {
-                /* Fault or hang: bring the GPU back so the next client call works. */
-                if (!j7m_recover()) {
-                    gJ7MServing = false;
-                    IOLog("J7 G3D: recovery failed; GPU service stopped\n");
+                /* A soft reset tears down the MMU, the cores and every mapping; doing that for
+                 * every failed chain was the bulk of the frame time.  Only reset once a few
+                 * have failed in a row, or at once when the MMU itself faulted. */
+                static unsigned consecutiveFailures;
+                if (++consecutiveFailures >= 4 || rc == -3) {
+                    consecutiveFailures = 0;
+                    if (!j7m_recover()) {
+                        gJ7MServing = false;
+                        IOLog("J7 G3D: recovery failed; GPU service stopped\n");
+                    }
                 }
             }
             args->scalarOutput[0] = static_cast<uint64_t>(static_cast<int64_t>(rc));
