 /*
  * j7gpu=4: reset the GPU, power L2 -> shader -> tiler (the Panfrost order), check READY, power them
  * off again.  Only GPU_CONTROL registers below 0x230 are touched; no address space, no job slot,
@@ -970,6 +1420,7 @@
         ml_io_unmap(pmu, 0x1000);
         return;
     }
