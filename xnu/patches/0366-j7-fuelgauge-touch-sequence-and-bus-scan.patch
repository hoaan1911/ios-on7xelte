From: j7 fb
Subject: j7: use the touch driver's I2C sequence and find the fuel gauge bus

IICSTAT read back exactly the 0xf0 that had just been written, and the bus stayed

busy through a STOP and a settle: that is a transfer that never started, not one

that failed. a5xelte_touch.c proves the sequence on this SoC - control, filter,

mode, address, mode|ENABLE - on two different buses, so use it, and probe each

S3C I2C controller for the gauge instead of trusting one address. Read-only

registers only; the scan logs one line per bus.

Co-Authored-By: dipa-studio <183933817+dipa-studio@users.noreply.github.com>

diff --git a/bsd/dev/a5xelte_battery.c b/bsd/dev/a5xelte_battery.c
--- a/bsd/dev/a5xelte_battery.c
+++ b/bsd/dev/a5xelte_battery.c
@@ -107,16 +107,15 @@
 		}
 		delay(1);
 	}
-	/* Prescaler 3: the register-pointer write completed at this rate, and the slowest step
-	 * (0xef) made even that fail, so the bus is already as slow as it wants to be. */
+	/* The order and the values are a5xelte_touch.c's, which are the ones that answer on this
+	 * SoC: control and filter, address into IICDS, the mode byte into IICSTAT, then the same
+	 * byte with ENABLE. Written address-then-mode with a STOP in between, IICSTAT read back
+	 * exactly the 0xf0 just written, which is a transfer that never started rather than one
+	 * that failed. */
 	fg_wr(FG_CON, 0xe3u);
-	/* The failure is IICSTAT bit 5 never dropping, so issue an explicit STOP and let the
-	 * lines settle before the address byte instead of charging into a busy bus. */
-	fg_stop();
-	delay(200);
 	fg_wr(FG_FILTER, 7u);
-	fg_wr(FG_DS, FG_ADDR | (receive ? 1u : 0u));
 	fg_wr(FG_STAT, receive ? FG_MODE_RX : FG_MODE_TX);
+	fg_wr(FG_DS, FG_ADDR | (receive ? 1u : 0u));
 	delay(1);
 	fg_wr(FG_STAT, (receive ? FG_MODE_RX : FG_MODE_TX) | 0x20u);
 	if (!fg_wait() || (fg_rd(FG_STAT) & 1u)) {
@@ -176,17 +175,31 @@
 	if (!enabled) {
 		return -1;
 	}
-	fg_i2c = ml_io_map(FG_I2C_PA, 0x1000);
-	if (!fg_i2c) {
-		return -1;
-	}
-	uint16_t soc = 0xffff;
-	if (!fg_word(FG_REPSOC, &soc)) {
-		printf("A5XELTE FG: nothing at 0x3b on the i2c@13830000 bus\n");
-		return -1;
+	/* Samsung's own tree does not agree between the 7870 boards about which controller the
+	 * gauge hangs off, and the touch driver here already proves two of them answer
+	 * (0x13840000 and 0x13850000). Ask every S3C I2C controller for the same read-only
+	 * register and keep the one that ACKs instead of trusting a single address. */
+	static const uint32_t buses[] = {
+		0x13830000u, 0x13860000u, 0x13870000u, 0x13880000u, 0x13890000u,
+	};
+	for (unsigned i = 0; i < sizeof(buses) / sizeof(buses[0]); i++) {
+		uint16_t soc = 0xffff;
+		fg_i2c = ml_io_map(buses[i], 0x1000);
+		if (!fg_i2c) {
+			continue;
+		}
+		fg_errors = 1000000u;   /* the scan logs itself, one line per bus */
+		if (fg_word(FG_REPSOC, &soc)) {
+			fg_errors = 0;
+			printf("A5XELTE FG: S2MU004 on 0x%08x, RSOC=%#x (1/16384 of full)\n",
+			    buses[i], soc);
+			return 0;
+		}
+		printf("A5XELTE FG: nothing at 0x3b on 0x%08x, stat=%#x con=%#x\n",
+		    buses[i], fg_rd(FG_STAT), fg_rd(FG_CON));
 	}
-	printf("A5XELTE FG: S2MU004 answers, RSOC=%#x (1/16384 of full)\n", soc);
-	return 0;
+	printf("A5XELTE FG: no gauge answered on any I2C bus\n");
+	return -1;
 }
 
