From: j7
Subject: j7: ask the gauge at the addresses it can have

The gauge answered on none of the six S3C controllers at 0x3b, and the boot log shows every
one of them refusing the address. The charger/FG block on this phone is an S2MU005, part of the
same part as the PMIC that answers as 0x66, so the address is not a given: ask 0x3b, 0x66 and
0x1b, on the bus Samsung's tree documents first and then on the others, and keep the pair that
ACKs.

The percentage assumption was wrong too: RSOC is hundredths of a percent on one vendor layout and
1/16384 of full on another, and the code assumed the first. Read the layout the value fits.

Co-Authored-By: dipa-studio <183933817+dipa-studio@users.noreply.github.com>

--- a/bsd/dev/a5xelte_battery.c
+++ b/bsd/dev/a5xelte_battery.c
@@ -24,7 +24,7 @@
     unsigned *full_mah);
 
 #define FG_I2C_PA       0x13830000u     /* S3C2440-layout I2C, as i2c@13830000 */
-#define FG_ADDR         0x76u           /* 7-bit 0x3b */
+static uint8_t fg_addr = 0x76u;     /* 7-bit 0x3b; the scan moves it if the gauge is elsewhere */
 #define FG_CON          0x00u           /* IICCON */
 #define FG_STAT         0x04u           /* IICSTAT */
 #define FG_DS           0x0cu           /* IICDS */
@@ -115,7 +115,7 @@
 	fg_wr(FG_CON, 0xe3u);
 	fg_wr(FG_FILTER, 7u);
 	fg_wr(FG_STAT, receive ? FG_MODE_RX : FG_MODE_TX);
-	fg_wr(FG_DS, FG_ADDR | (receive ? 1u : 0u));
+	fg_wr(FG_DS, (uint32_t)fg_addr | (receive ? 1u : 0u));
 	delay(1);
 	fg_wr(FG_STAT, (receive ? FG_MODE_RX : FG_MODE_TX) | 0x20u);
 	if (!fg_wait() || (fg_rd(FG_STAT) & 1u)) {
@@ -208,32 +208,33 @@
 		return -1;
 	}
 	fg_clock_on();
-	/* Samsung's own tree does not agree between the 7870 boards about which controller the
-	 * gauge hangs off, and the touch driver here already proves two of them answer
-	 * (0x13840000 and 0x13850000). Ask every S3C I2C controller for the same read-only
-	 * register and keep the one that ACKs instead of trusting a single address. */
-	/* All six S3C I2C controllers, and the two that are known to answer first: 0x13840000
-	 * and 0x13850000 already carry the touch controller, so their clocks and pin muxes are
-	 * live, and every earlier scan skipped exactly those two. The gauge is addressed as
-	 * 0x76, which touches nothing else on the bus. */
+	/* Samsung's tree puts the gauge on I2C4 at 0x3b, and this phone answers on none of the
+	 * six controllers at that address.  The charger/FG part is an S2MU005 block whose sibling
+	 * PMIC answers as 0x66, so ask the three addresses it can have, on the bus Samsung
+	 * documents first and then on the rest.  The first pair that ACKs is kept. */
 	static const uint32_t buses[] = {
-		0x13840000u, 0x13850000u, 0x13830000u, 0x13860000u, 0x13870000u,
+		0x13830000u, 0x13840000u, 0x13850000u, 0x13860000u, 0x13870000u,
 		0x13880000u, 0x13890000u,
 	};
+	static const uint8_t addrs[] = { 0x76u, 0x66u, 0x1bu };
+
 	for (unsigned i = 0; i < sizeof(buses) / sizeof(buses[0]); i++) {
-		uint16_t soc = 0xffff;
 		fg_i2c = ml_io_map(buses[i], 0x1000);
 		if (!fg_i2c) {
 			continue;
 		}
-		fg_errors = 1000000u;   /* the scan logs itself, one line per bus */
-		if (fg_word(FG_REPSOC, &soc)) {
-			fg_errors = 0;
-			printf("A5XELTE FG: S2MU004 on 0x%08x, RSOC=%#x (1/16384 of full)\n",
-			    buses[i], soc);
-			return 0;
+		for (unsigned a = 0; a < sizeof(addrs) / sizeof(addrs[0]); a++) {
+			uint16_t soc = 0xffff;
+			fg_addr = addrs[a];
+			fg_errors = 1000000u;   /* the scan logs itself, one line per bus */
+			if (fg_word(FG_REPSOC, &soc)) {
+				fg_errors = 0;
+				printf("A5XELTE FG: gauge on 0x%08x at 0x%02x, RSOC=%#x\n",
+				    buses[i], fg_addr, soc);
+				return 0;
+			}
 		}
-		printf("A5XELTE FG: nothing at 0x3b on 0x%08x, stat=%#x con=%#x\n",
+		printf("A5XELTE FG: nothing on 0x%08x, stat=%#x con=%#x\n",
 		    buses[i], fg_rd(FG_STAT), fg_rd(FG_CON));
 	}
 	printf("A5XELTE FG: no gauge answered on any I2C bus\n");
@@ -245,14 +246,22 @@
     unsigned *full_mah)
 {
 	uint16_t soc, vbat, cur, cap;
+	unsigned raw, p;
 
 	if (!fg_i2c || !fg_word(FG_REPSOC, &soc) || !fg_word(FG_RVBAT, &vbat) ||
 	    !fg_word(FG_RCUR, &cur) || !fg_word(FG_RBATCAP, &cap)) {
 		return -1;
 	}
-	/* 0..10000 = 0..100.0 % of full, scaled so capacity_max (99.0 %) reads 100 %. */
-	unsigned p = ((unsigned)(soc & 0x7fffu) * 1000u) / (100u * FG_CAPACITY_MAX);
-	*percent = p > 100 ? 100 : p;
+	/* Two layouts are in the vendor tree for this register: hundredths of a percent
+	 * (0..10000, full = capacity_max 99.0 %) and 1/16384 of full.  Take the one the value
+	 * fits instead of assuming, which is why the percentage never matched the phone. */
+	raw = soc & 0x7fffu;
+	if (raw <= 10000u) {
+		p = raw * 1000u / FG_CAPACITY_MAX;
+	} else {
+		p = raw * 1000u / 16384u;
+	}
+	*percent = p >= 1000u ? 100u : p / 10u;
 	*mv = (unsigned)(((uint64_t)(vbat & 0x7fffu) * 1000u) >> 13);
 	*ma = (cur & 0x8000u)
 	    ? -(int)(((((unsigned)~cur & 0xffffu) + 1u) * 1000u) >> 12)
